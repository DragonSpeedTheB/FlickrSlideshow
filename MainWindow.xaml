<Window x:Class="FlickrSlideshow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flickr Slideshow"
        Height="155"
        Width="511"
        MinHeight="400"
        MinWidth="600"
        PreviewKeyDown="MainWindow_KeyDown"
        KeyDown="MainWindow_KeyDown" 
        Icon="/flickr.png"
        Focusable="True"
        Background="LightGray"
        FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">

    <!-- SINGLE ROOT GRID -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top controls -->
        <StackPanel x:Name="TopControls" Grid.Row="0" Margin="10">
            <!-- User picker -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Flickr User:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="UserComboBox"
                          Width="200"
                          IsEditable="True"
                          DisplayMemberPath="Name"
                          SelectionChanged="UserComboBox_SelectionChanged"/>

                <Button x:Name="AddUserButton"
                        Content="Add User"
                        Margin="5,0,0,0"
                        Click="AddUser_Click"
                        ToolTip="Type a user in the field to the left and click on Add"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- Status message -->
            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,5"
                       Foreground="DarkGreen"
                       FontWeight="Bold"/>

            <!-- Version display (initial window) -->
            <TextBlock x:Name="VersionText"
                       Margin="0,0,0,8"
                       Foreground="Gray"
                       FontSize="12"
                       Text="Version: unknown"/>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AllPhotosButton"
                        Content="All Photos"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="AllPhotos_Click"
                        IsEnabled="False"/>

                <Button x:Name="PickAlbumsButton"
                        Content="Pick Albums"
                        Width="120"
                        Click="Albums_Click"
                        IsEnabled="False"/>

                <Button x:Name="ExploreButton"
                        Content="Explore"
                        Width="120"
                        Margin="10,0,0,0"
                        Click="Explore_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Slideshow + overlay -->
        <Grid Grid.Row="1">
            <Border Background="Black">
                <!-- ensure SlideImage will only be scaled down by WPF, never up -->
                <Image x:Name="SlideImage"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Border>

            <!-- Resume overlay (transparent so image stays visible when paused) -->
            <Border x:Name="ResumeOverlay" Background="Transparent" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Slideshow Paused" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                    <Button x:Name="ResumeButton" Content="Resume" Width="120" Height="40" Margin="10" Click="ResumeButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Caption in lower-left -->
            <TextBlock x:Name="CaptionText"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="10"
                       Foreground="White"
                       Background="#66000000"
                       Padding="6,4"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       FontSize="14"/>

            <!-- Debug info (visible only in DEBUG build) -->
            <TextBlock x:Name="DebugInfoText"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="10,40,0,10"
                       Foreground="White"
                       Background="#66000000"
                       Padding="6,4"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       FontSize="12"/>
        </Grid>
    </Grid>
</Window>

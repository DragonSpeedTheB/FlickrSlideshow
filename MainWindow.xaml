<Window x:Class="FlickrSlideshow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flickr Slideshow"
        Height="600"
        Width="800"
        MinHeight="400"
        MinWidth="600"
        PreviewKeyDown="MainWindow_KeyDown"
        KeyDown="MainWindow_KeyDown" Icon="/flickr.png">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top controls -->
            <RowDefinition Height="*"/>
            <!-- Slideshow -->
        </Grid.RowDefinitions>

        <!-- Top controls -->
        <StackPanel x:Name="TopControls" Grid.Row="0" Margin="10">
            <!-- User picker -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Flickr User:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="UserComboBox"
                          Width="200"
                          IsEditable="True"
                          DisplayMemberPath="Name"
                          SelectionChanged="UserComboBox_SelectionChanged"/>

                <Button x:Name="AddUserButton"
                        Content="Add User"
                        Margin="5,0,0,0"
                        Click="AddUser_Click"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- Status message -->
            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,5"
                       Foreground="DarkGreen"
                       FontWeight="Bold"/>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AllPhotosButton"
                        Content="All Photos"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="AllPhotos_Click"
                        IsEnabled="False"/>
                <Button x:Name="PickAlbumsButton"
                        Content="Pick Albums"
                        Width="120"
                        Click="Albums_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </StackPanel>

        <!-- Slideshow Image -->
        <Border Grid.Row="1" Background="Black">
            <Image x:Name="SlideImage"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Stretch="Uniform"/>
        </Border>
    </Grid>
</Window>

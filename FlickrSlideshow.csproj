<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>flickr.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.7.0.0</Version>
    <Platforms>AnyCPU;x64</Platforms>
    <IncludeSymbols>True</IncludeSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude sub-projects' folders — compiled as separate projects -->
    <Compile Remove="FlickrSlideshow.Core\**" />
    <Compile Remove="FlickrSlideshow.Xbox\**" />
    <Compile Remove="FlickrSlideshow.Xbox2\**" />
    <Compile Remove="FlickrSlideshow.XboxTest\**" />
    <Page Remove="FlickrSlideshow.Xbox\**" />
    <Page Remove="FlickrSlideshow.Xbox2\**" />
    <Page Remove="FlickrSlideshow.XboxTest\**" />
    <EmbeddedResource Remove="FlickrSlideshow.Xbox\**" />
    <EmbeddedResource Remove="FlickrSlideshow.Xbox2\**" />
    <EmbeddedResource Remove="FlickrSlideshow.XboxTest\**" />
    <None Remove="FlickrSlideshow.Xbox\**" />
    <None Remove="FlickrSlideshow.Xbox2\**" />
    <None Remove="FlickrSlideshow.XboxTest\**" />
    <!-- These files' content now lives in Core; keep as None so VS shows them -->
    <Compile Remove="FlickrService.cs" />
    <Compile Remove="FlickrModels.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FlickrService.cs" />
    <None Include="FlickrModels.cs" />
  </ItemGroup>



  <ItemGroup>
    <Content Include="flickr.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="FlickrSlideshow.Core\FlickrSlideshow.Core.csproj" />
    <None Include="FlickrSlideshow.Xbox2\FlickrSlideshow.Xbox2.csproj" />
    <None Include="FlickrSlideshow.XboxTest\FlickrSlideshow.XboxTest.csproj" />
    <None Include="FlickrSlideshow.Xbox\FlickrSlideshow.Xbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FlickrSlideshow.Core\FlickrSlideshow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="flickr.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="RemoveStandaloneCompanions" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishSingleFile)'=='true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' or '%(RelativePath)' == 'FlickrSlideshow.dll.config'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Appsettings.json" LogicalName="FlickrSlideshow.Appsettings.json" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>

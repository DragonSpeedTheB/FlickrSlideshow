<Page x:Class="FlickrSlideshow.Xbox.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="LightGray"><Grid x:Name="RootGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border x:Name="CompositorKeepAlive" Width="0" Height="0" Opacity="1"/><StackPanel x:Name="TopControls" Grid.Row="0" Margin="20,16,20,16"><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Flickr User:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="18"/><ComboBox x:Name="UserComboBox" Width="260" FontSize="16" Padding="8,6" PlaceholderText="select saved user" SelectionChanged="UserComboBox_SelectionChanged"/><Button x:Name="AddUserButton" Content="Add User" Margin="8,0,0,0" FontSize="16" Padding="12,6" IsEnabled="False" Click="AddUser_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="New user:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16" Foreground="Gray"/><TextBox x:Name="UsernameBox" Width="260" FontSize="16" Padding="6" PlaceholderText="type Flickr username" TextChanged="UsernameBox_TextChanged"/></StackPanel><TextBlock x:Name="StatusText" Margin="0,0,0,8" Foreground="DarkGreen" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button x:Name="AllPhotosButton" Content="All Photos" Width="160" FontSize="16" Padding="8,8" Margin="0,0,12,0" Click="AllPhotos_Click" IsEnabled="False"/><Button x:Name="PickAlbumsButton" Content="Pick Albums" Width="160" FontSize="16" Padding="8,8" Margin="0,0,12,0" Click="PickAlbums_Click" IsEnabled="False"/><Button x:Name="ExploreButton" Content="Explore" Width="160" FontSize="16" Padding="8,8" Click="Explore_Click"/></StackPanel></StackPanel><Grid Grid.Row="1"><Border Background="Black"><Image x:Name="SlideImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Background="#66000000" Padding="6,4"><TextBlock x:Name="CaptionText" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="14" MaxWidth="800"/></Border><TextBlock x:Name="LoadingText" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" Foreground="White" TextAlignment="Center"/><Border x:Name="ResumeOverlay" Background="Transparent" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Slideshow Paused" Foreground="White" FontSize="24" HorizontalAlignment="Center"/><Button x:Name="ResumeButton" Content="Resume" Width="160" Height="44" Margin="0,12,0,0" FontSize="18" Click="ResumeButton_Click"/></StackPanel></Border><Grid x:Name="QuitOverlay" Visibility="Collapsed" Background="#CC000000"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Quit Flickr Slideshow?" FontSize="32" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24"><Button x:Name="QuitYesButton" Content="Yes, Quit" FontSize="20" Padding="20,10" Click="QuitYes_Click"/><Button x:Name="QuitNoButton" Content="No, Continue" FontSize="20" Padding="20,10" Click="QuitNo_Click"/></StackPanel></StackPanel></Grid></Grid><Grid x:Name="AlbumPickerOverlay" Visibility="Collapsed" Grid.RowSpan="2" Background="#EE000000"><Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" MaxHeight="600"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Select Albums" FontSize="24" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/><TextBox Grid.Row="1" x:Name="AlbumFilterBox" PlaceholderText="Filter..." FontSize="16" Padding="6" Margin="0,0,0,8" TextChanged="AlbumFilter_TextChanged"/><ListBox Grid.Row="2" x:Name="AlbumList" SelectionMode="Multiple" Background="#33FFFFFF"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="OK" Width="100" FontSize="16" Padding="8" Margin="0,0,10,0" Click="AlbumOk_Click"/><Button Content="Cancel" Width="100" FontSize="16" Padding="8" Click="AlbumCancel_Click"/></StackPanel></Grid></Grid></Grid></Page>
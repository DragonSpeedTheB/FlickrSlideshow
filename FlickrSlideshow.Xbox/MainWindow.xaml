<Window
    x:Class="FlickrSlideshow.Xbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Flickr Slideshow">

    <Grid x:Name="RootGrid" Background="Black">

        <!-- Full-screen photo -->
        <Image x:Name="SlideImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <!-- Title caption - safe-area offset for Xbox (TV overscan) -->
        <TextBlock x:Name="CaptionText"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="80,0,0,60"
                   FontSize="28"
                   Foreground="White"
                   TextWrapping="Wrap"
                   MaxWidth="900" />

        <!-- Gamepad hint bar -->
        <StackPanel VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Margin="0,0,80,60"
                    Spacing="16">
            <TextBlock Text="◀ ▶  Navigate"  Foreground="#CCFFFFFF" FontSize="18" />
            <TextBlock Text="  A  Pause"      Foreground="#CCFFFFFF" FontSize="18" />
            <TextBlock Text="  B  Resume"     Foreground="#CCFFFFFF" FontSize="18" />
        </StackPanel>

        <!-- Pause overlay -->
        <Border x:Name="PauseOverlay"
                Visibility="Collapsed"
                Background="#99000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Padding="48,24">
            <TextBlock Text="⏸  Paused"
                       FontSize="48"
                       Foreground="White"
                       HorizontalAlignment="Center" />
        </Border>

    </Grid>
</Window>

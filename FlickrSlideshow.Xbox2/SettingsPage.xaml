<Page x:Class="FlickrSlideshow.Xbox2.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="LightGray"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="40,24,40,16"><TextBlock FontSize="28" FontWeight="Bold" Margin="0,0,0,16"><Run Text="Flickr" Foreground="#0063DC"/><Run Text=" Slideshow" Foreground="#FF0084"/></TextBlock><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Flickr User:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"/><ComboBox x:Name="UserComboBox" Width="280" FontSize="16" Padding="8,6" SelectionChanged="UserComboBox_SelectionChanged"/><Button Background="Black" Foreground="White" x:Name="RemoveUserButton" Content="Remove" Margin="8,0,0,0" FontSize="14" Padding="10,6" IsEnabled="False" Click="RemoveUser_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Add new user:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16" Foreground="Gray"/><TextBox x:Name="UsernameBox" Width="280" FontSize="16" Padding="6" TextChanged="UsernameBox_TextChanged"/><Button Background="Black" Foreground="White" x:Name="AddUserButton" Content="Add" Margin="8,0,0,0" FontSize="16" Padding="16,6" IsEnabled="False" Click="AddUser_Click"/></StackPanel><TextBlock x:Name="StatusText" FontSize="16" FontWeight="Bold" Foreground="DarkGreen" TextWrapping="Wrap" Margin="0,0,0,12"/><CheckBox x:Name="DebugOutputCheckBox" Content="Debug Output" FontSize="14" Margin="0,0,0,12" Checked="DebugOutput_Changed" Unchecked="DebugOutput_Changed"/><StackPanel Orientation="Horizontal"><Button Background="Black" Foreground="White" x:Name="AllPhotosButton" Content="All Photos" FontSize="16" Width="160" Padding="8,10" Margin="0,0,12,0" Click="AllPhotos_Click" IsEnabled="False"/><Button Background="Black" Foreground="White" x:Name="PickAlbumsButton" Content="Pick Albums" FontSize="16" Width="160" Padding="8,10" Margin="0,0,12,0" Click="PickAlbums_Click" IsEnabled="False"/><Button Background="Black" Foreground="White" x:Name="ExploreButton" Content="Explore" FontSize="16" Width="160" Padding="8,10" Click="Explore_Click"/><Button Background="Black" Foreground="White" Content="Quit" FontSize="16" Width="160" Padding="8,10" Margin="12,0,0,0" Click="QuitButton_Click"/></StackPanel></StackPanel><Grid x:Name="QuitOverlay" Visibility="Collapsed" Background="#A6000000" Grid.RowSpan="2"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,60"><TextBlock Text="Quit Flickr Slideshow?" FontSize="32" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Background="Black" Foreground="White" x:Name="QuitYesButton" Content="Yes, Quit" FontSize="20" Padding="24,12" Margin="0,0,20,0" Click="QuitYes_Click"/><Button Background="Black" Foreground="White" Content="No, Continue" FontSize="20" Padding="24,12" Click="QuitNo_Click"/></StackPanel></StackPanel></Grid></Grid></Page>
<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">

  <Identity Name="Dragonspeed.FlickrSlideshowRandomizer"
            Publisher="CN=4E6E4F0E-9A90-4CA4-AAA5-BCAB14EE805D"
            Version="2.0.7.0" ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000000"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Flickr Slideshow Randomizer</DisplayName>
    <PublisherDisplayName>Dragonspeed</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="2.0.7.0"
                        MaxVersionTested="10.0.26100.0" />
      <TargetDeviceFamily Name="Windows.Xbox" MinVersion="2.0.7.0" MaxVersionTested="10.0.26100.0" />
</Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="FlickrSlideshow.Xbox2.App">
      <uap:VisualElements DisplayName="Flickr Slideshow Randomizer"
                          Description="Flickr photo slideshow"
                          BackgroundColor="black"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="black" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>

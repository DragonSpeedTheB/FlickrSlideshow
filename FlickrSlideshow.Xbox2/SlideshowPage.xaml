<Page x:Class="FlickrSlideshow.Xbox2.SlideshowPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Black"><Grid><Border x:Name="KeepAlive" Width="0" Height="0" Opacity="1"/><Image x:Name="SlideImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Background="#66000000" Padding="6,4"><TextBlock x:Name="CaptionText" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="14" MaxWidth="900"/></Border><TextBlock x:Name="LoadingText" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="26" Foreground="White" TextAlignment="Center"/><Border x:Name="PausedOverlay" Visibility="Collapsed" Background="Transparent"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Slideshow Paused" Foreground="White" FontSize="28" HorizontalAlignment="Center"/><Button Background="Black" Foreground="White" x:Name="ResumeButton" Content="Resume" Width="180" Height="48" Margin="0,16,0,0" FontSize="20" Click="ResumeButton_Click"/><Button Background="Black" Foreground="White" Content="Back to Settings" Width="180" Height="48" Margin="0,8,0,0" FontSize="18" Click="BackToSettings_Click"/></StackPanel></Border><TextBlock x:Name="PausedIndicator" Visibility="Collapsed" Text="--- PAUSED ---" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,48" FontSize="28" FontWeight="Bold" Foreground="Orange"/><Grid x:Name="QuitOverlay" Visibility="Collapsed" Background="#CC000000"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Quit Flickr Slideshow?" FontSize="32" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Background="Black" Foreground="White" Margin="0,0,20,0" x:Name="QuitYesButton" Content="Yes, Quit" FontSize="20" Padding="24,12" Click="QuitYes_Click"/><Button Background="Black" Foreground="White" Content="No, Continue" FontSize="20" Padding="24,12" Click="QuitNo_Click"/></StackPanel></StackPanel></Grid></Grid></Page>